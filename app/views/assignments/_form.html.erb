<%= render ModalComponent.new do %>
	<%= form_with( model: resource_route(@assignment),
			authenticity_token: true,
			data: {controller: "mandatory-fields", turbo_frame: "_top"}
		) do |form| %>
		<%= form.hidden_field :membership_id,  value: @member&.id %>
		<% @kind_f.form = form if @kind_f %>
		<% if @p_fields %>
			<%= form.fields_for :person_attributes, @assignment.person do |f| %>
				<% @p_header.form = f %>
				<% @p_fields.form = f %>
				<%= render @p_header %>
				<%= render @kind_f %>
				<%= render @p_fields %>
				<% if @contacts %>
					<% @contacts.form = f %>
					<%= render @contacts %>
				<% end %>
			<% end %>
		<% end %>
		<% @a_fields.form = form %>
		<%= render @a_fields %>
		<%= render @submit %>
	<% end %>
<% end %>
