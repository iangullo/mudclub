<%= t("mailers.shared.greeting", requester: @snapshot.requester) %>
<br>
<p>
<% if @snapshot.team %>
    <%= t(".body_with_team", candidate: @snapshot.candidate, kind: @snapshot.kind, club: @snapshot.club, team: @snapshot.team) %>
<% else %>
    <%= t(".body", candidate: @snapshot.candidate, kind: @snapshot.kind, club: @snapshot.club) %>
<% end %>
</p>
<br>
<%= t(".closing", club: @snapshot.club) %>
