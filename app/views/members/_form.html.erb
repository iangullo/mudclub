<%= render ModalComponent.new do %>
	<%= form_for @member, authenticity_token: true, data:{controller: "mandatory-fields", turbo_frame: "_top"} do |form| %>
		<%= form.fields_for :person do |f| %>
			<% @title.form    = f %>
			<% @fields.form = f %>
			<%= render @title %>
			<%= render @fields %>
		<% end %>
		<%= render @submit %>
	<% end %>
<% end %>
