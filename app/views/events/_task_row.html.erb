<% if form.object %>
	<% f_cls = "rounded-sm inset-shadow-sm border-indigo-100 bg-gray-50 focus:ring-3-blue-700 focus:border-blue-700 py-0 px-0 m-1 align-middle" %>
	<div class="float-left">
		<%= form.hidden_field :drill_id %>
		<%= form.object.drill&.nice_string.presence || "-" %>
	</div>
	<div class="float-right">
		<%= form.number_field :duration, value: form.object.duration, min: 1, max: 90, size: 3, class: "#{f_cls} text-right" %>
		<%= render ButtonComponent.new(kind: :edit, label: "", align: :right, url: path_for(form.object.event, action: :edit_task, task_id: form.object.id)) %>
		<%= render ButtonComponent.new(kind: :remove, action: 'click->sortable#remove', frame: 'sortable-list', data: {target: 'sortable.item', id: form.object.id ,prevent_default: true}) %>
	</div>
<% end %>
