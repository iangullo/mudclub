<!DOCTYPE html>
<html>
	<head>
		<title><%= @clubname %></title>
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<%= csrf_meta_tags %>
		<%= csp_meta_tag %>
		<%= stylesheet_link_tag "tailwind", "trix", "actiontext", "application", "data-turbo-track": "reload" %>
		<%= javascript_importmap_tags %>
		<%
		active_favicon = (@club.is_a?(Club) && @club.avatar.attached?) ? @club.avatar : @favicon
		favicon_href =
			if active_favicon.respond_to?(:attached?) && active_favicon.attached?
			if active_favicon.variable?
				rails_representation_path(active_favicon.variant(resize_to_limit: [64, 64]), only_path: true)
			else
				rails_storage_proxy_path(active_favicon, only_path: true)
			end
			else
			asset_path(active_favicon.presence || "mudclub.svg")
			end
		favicon_type = favicon_href.to_s.end_with?(".svg") ? "image/svg+xml" : "image/png"
		%>
		<%= favicon_link_tag favicon_href, id: "favicon", rel: "icon", type: favicon_type %>
		<script>
		document.addEventListener("turbo:load", () => {
			const link = document.getElementById("favicon");
			if (!link) return;
			const fresh = link.cloneNode(true);
			link.replaceWith(fresh);
		});
		</script>
	</head>

	<body class="h-screen flex flex-col text-fluid">
		<header class="flex-none sticky top-0 z-50 w-full h-14 bg-blue-900 text-gray-300">
			<%= render @topbar %>
			<%= render FlashComponent.new(notice) if notice %>
		</header>
		<% if @title %>
		<div class="flex sticky top-14 justify-center bg-white text-black border-b border-gray-300 p-2">
			<%= render @title %>
		</div>
		<% end %>

		<%= turbo_frame_tag "modal" %>
		<!-- App content goes here -->
		<main class="flex-1 min-w-0 min-h-0 overflow-auto">
    		<div class="p-2 flex flex-col gap-2 mx-auto w-full max-w-7xl min-w-0">
				<div class="w-fit max-w-full mx-auto">
					<%= yield %>
				</div>
		  		<%= render @footer if @footer %>
			</div>
		</main>

		<!-- Conditional footer content -->
		<% if user_signed_in? %>
		<footer class="flex-none sticky bottom-0 bg-white border-t border-gray-300">
		  <div class="max-w-7xl mx-auto">
			<div class="text-center text-xs text-gray-500">
				<a href="<%= about_server_path %>" data-turbo-frame= "modal"><%= "#{server_about_version} © iangullo (#{Time.current.year})" %></a>
			</div>
		  </div>
		</footer>
		<% end %>
	</body>
</html>
