<%# app/views/home/my_registrations.html.erb %>
<div id="mudclub-my_registrations" class="max-w-3xl mx-auto p-4">
  <% if @table %>
    <%= render @table %>
    <% unless user_signed_in? %>
      <p class="mt-3 text-xs text-gray-600">
        <%= my_registrations_hint %>
      </p>
    <% end %>
  <% else %>
    <%= render @fields if @fields %>
  <% end %>

  <%= render @submit if @submit %>
</div>