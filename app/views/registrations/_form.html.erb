<%= render ModalComponent.new do %>
	<%= form_with(
		model: resource_route(@registration),
		data: {
			controller: "mandatory-fields optional-fields",
			turbo_frame: "modal"
		},
		authenticity_token: true
	) do |form| %>
    	<!-- Candidate -->
		<% @fields.form = form %>
		<%= form.fields_for :candidate, @registration.person do |f| %>
			<% @p_header.form = f %>
			<% @p_fields.form = f %>
			<%= render @p_header %>
			<%= render @p_fields %>
			<%= render @fields %>
		<% end %>

		<% if @r_fields %>
      	<!-- Switch -->
		<div class="my-2">
			<%= form.check_box(:different_requester,
				data: {
					optional_fields_target: "switch",
					optional_target: "requester",
					action: "change->optional-fields#toggle"
				}
				) %>

			<%= label_tag(:different_requester,Registration.fld(:different_requester)) %>
		</div>

		<!-- Optional requester section -->
		<div class="hidden" data-optional-fields-target="section" data-optional-name="requester">
			<%= form.fields_for :requester, @registration.requester do |fr| %>
			<% @r_fields.form = fr %>
			<%= render @r_fields %>
			<% end %>
		</div>
		<% end %>
		<%= render @submit %>
	<% end %>
<% end %>
