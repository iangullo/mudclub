<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
	<%= render FieldsComponent.new(
		[
			[{kind: :side_cell, value: t("devise.actions.login"), align: "center", cols: 5}],
			[
				{kind: :header_icon, symbol: :user, rows: 2},
				{kind: :symbol, symbol: {concept: :email, type: :button}},
				{kind: :email_box, key: :email, autocomplete: User.fld(:email), cols: 3}
			],
			[
				{kind: :symbol, symbol: :key},
				{kind: :password_box, key: :password, autocomplete: Person.fld(:password), cols: 3}
			],
			[
				gap_field(size: 1, cols: 2),
				{kind: :label_checkbox, label: I18n.t("devise.actions.remember"), key: :remember_me, right: true},
				gap_field,
				{kind: :button, button: {kind: :login, label: t("devise.actions.login"), confirm: I18n.t("devise.messages.login"), align: "right"}}
			]
		],
		form: f
	) %>
	<div class="text-right text-sm"><%= render "devise/shared/links" %></div>
<% end %>
