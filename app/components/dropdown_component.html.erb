<% sub      = @button[:sub] %>
<% chevron  = chevron_side %>     <%# :down / :left / :right %>
<% flipped  = flipped? %>         <%# true when this menu opens leftward %>
<% btn_cls  = @button[:b_class] %>
<% btn_cls += " justify-end" if chevron == :left %>

<div class="<%= wrapper_class %>" data-controller="dropdown">

	<% if @button[:append] %>
		<%= @button[:label] %>
	<% end %>

	<button id="<%= @button[:id] %>"
	        class="<%= btn_cls %>"
	        type="button"
	        title="<%= @button[:title] %>"
	        aria-expanded="false"
	        data-dropdown-target="trigger"
	        data-action="click->dropdown#toggle">
		<% if @button[:ham] %>
			<svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		<% elsif @button[:symbol] || @button[:icon] %>
			<%= render_image(@button, size: "25x25") %>
		<% end %>

		<% if @button[:label] && !@button[:append] %>
			<%# Chevron on the left for flipped subs (submenu opens leftward) %>
			<% if chevron == :left %>
				<svg class="w-4 h-4 shrink-0 rotate-180" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
			<% end %>

			<span class="truncate"><%= @button[:label] %></span>

			<%# Chevron on the right for normal subs (submenu opens rightward) %>
			<% if chevron == :right %>
				<svg class="w-4 h-4 shrink-0" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
			<% end %>

			<%# Down chevron for top-level menus %>
			<% if chevron == :down %>
				<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
			<% end %>
		<% end %>
	</button>

	<div id="<%= @button[:name] %>"
	     class="<%= @button[:d_class] %>"
	     data-dropdown-target="menu">
		<ul aria-labelledby="<%= @button[:id] %>">
			<% @button[:options].each do |option| %>
			<li class="<%= @button[:o_class] %>">
				<% if option[:options] %>
					<%= render DropdownComponent.new(option.dup.tap { |o|
						o[:sub]          = true
						o[:parent_place] = @button[:place]
					}) %>
				<% else %>
					<%= link_to option[:url], data: option[:data], class: link_classes do %>
						<%= render_image(option, size: "25x25") if (option[:icon] || option[:symbol]) %><%= option[:label] if option[:label] %>
					<% end %>
				<% end %>
			</li>
			<% end %>
		</ul>
	</div>
</div>